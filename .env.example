# Copy to backend/.env (and keep out of git)
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://jobportal:jobportal_dev_pw@localhost:5433/jobportal?schema=public
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGIN=http://localhost:5173
STORAGE_DRIVER=local          # local | s3
UPLOAD_DIR=./uploads
S3_BUCKET=
AWS_REGION=us-east-1
LOG_LEVEL=info
# Auth endpoints: max attempts per IP per 15 min (use ~30 in production; raised for local E2E runs)
AUTH_RATE_LIMIT_MAX=1000
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_PASSWORD=Password@123
# docker compose overrides
POSTGRES_USER=jobportal
POSTGRES_PASSWORD=jobportal_dev_pw
POSTGRES_DB=jobportal
POSTGRES_HOST_PORT=5433
